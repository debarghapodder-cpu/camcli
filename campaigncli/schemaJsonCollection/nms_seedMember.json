                        "type": "string",
                        "required": true
                    },
                    {
                        "name": "refIdName",
                        "type": "string",
                        "required": true
                    },
                    {
                        "name": "refIdValue",
                        "type": "int",
                        "required": true
                    },
                    {
                        "name": "selection",
                        "type": "Element",
                        "required": true
                    },
                    {
                        "name": "parentIn",
                        "type": "Element",
                        "required": true
                    }
                ],
                "element": "getAsModel"
            },
            "output": {
                "message": "getAsModelOut",
                "parameters": [
                    {
                        "name": "parentOut",
                        "type": "Element",
                        "required": true
                    }
